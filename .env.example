# Copy to repo-root .env or backend/.env
CHAT_MODE=dummy
GROQ_API_KEY=
JINA_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Comma-separated browser origins allowed by backend CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Data layer ────────────────────────────────────────────────
# Default: zero-setup local SQLite file (backend/finance_rag.db).
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/llm_db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/finance_rag
DATABASE_URL=

# Object storage: local (filesystem) now; S3/MinIO compatible later.
STORAGE_BACKEND=local
STORAGE_PATH=
