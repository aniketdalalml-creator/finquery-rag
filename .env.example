# ── Database (compose MySQL service) ─────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=llm_db
MYSQL_USER=finquery
MYSQL_PASSWORD=change-me

# Local dev only (outside Docker): point the backend at your own DB.
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/llm_db

# ── AI providers ─────────────────────────────────────────────
GROQ_API_KEY=
JINA_API_KEY=

# Embeddings for document_chunks (falls back to JINA_API_KEY)
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v2-base-en
EMBEDDING_BATCH_SIZE=32

# ── Qdrant (in Docker this is injected automatically) ────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# ── App ──────────────────────────────────────────────────────
CHAT_MODE=rag
STORAGE_BACKEND=local
STORAGE_PATH=backend/storage_data
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
